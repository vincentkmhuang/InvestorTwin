{
  "schemaVersion": "013-a",
  "layer": "evidence",
  "canonicalBrief": "data/morning-brief.json",
  "writesBrief": false,
  "directories": {
    "raw": "data/evidence/runs/{runId}/raw/{sourceId}.json",
    "normalized": "data/evidence/runs/{runId}/normalized/{instrument}.json",
    "history": "data/evidence/history/{instrument}/{asOf}.json"
  },
  "rawRequired": [
    "sourceId",
    "capturedAt",
    "source",
    "status"
  ],
  "rawOptional": [
    "payload",
    "fileRef",
    "error"
  ],
  "normalizedRequired": [
    "instrument",
    "sourceId",
    "status"
  ],
  "normalizedWhenValued": [
    "value",
    "unit",
    "asOf",
    "asOfKind",
    "priorValue",
    "changeDoD",
    "changeWoW"
  ],
  "statuses": ["fresh", "stale", "missing", "unavailable"],
  "asOfPolicy": "asOf comes from the source observation only. capturedAt is fetch time. expectedAsOf is used only to classify fresh/stale/missing. Never overwrite asOf with the system clock.",
  "changePolicy": "changeDoD and changeWoW are computed from prior source asOf values in payload or history. If history is insufficient, the change is null and change status is unavailable.",
