    "bootstrap-state.example.json",
    "history/by-url/index.example.json",
    "history/by-url/.gitkeep",
    "runs/.gitkeep",
    "runs/run.template.json"
  ],
  "runtimeGitignored": [
    "seen.json",
    "pipeline-seen.json",
    "bootstrap-state.json",
    "history/by-url/index.json",
    "runs/run-*/"
