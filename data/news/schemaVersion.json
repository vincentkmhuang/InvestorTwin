  "newsObjectContract": "data/news/news-object-v1.contract.json",
  "sourceIdV1": "cna-finance-rss",
  "sourceIds": ["cna-finance-rss", "fsc-press-rss", "twse-news-openapi", "mops-material-openapi"],
